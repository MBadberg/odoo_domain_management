<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.domain</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Domain Management" name="odoo_domain_management">
                    <block title="Domainrobot API">
                        <setting id="domainrobot_api_url_setting" string="API Endpoint URL"
                                 help="Base URL for the Domainrobot API (sandbox and production use the same URL; credentials differ).">
                            <field name="domainrobot_api_url"
                                   placeholder="https://api.domainreselling.de/api/call.cgi"/>
                        </setting>
                        <setting id="domainrobot_api_user_setting" string="API Username (s_login)">
                            <field name="domainrobot_api_user" placeholder="s_login"/>
                        </setting>
                        <setting id="domainrobot_api_password_setting" string="API Password (s_pw)">
                            <field name="domainrobot_api_password" placeholder="s_pw"/>
                        </setting>
                        <setting id="domainrobot_api_timeout_setting" string="API Timeout (seconds)">
                            <field name="domainrobot_api_timeout"/>
                        </setting>
                    </block>

                    <block title="GitHub update">
                        <setting id="domainrobot_module_version_setting" string="Installed version">
                            <field name="module_version" readonly="1"/>
                        </setting>
                        <setting id="domainrobot_github_repository_setting" string="GitHub repository URL">
                            <field name="github_repository_url" placeholder="https://github.com/MBadberg/odoo_domain_management"/>
                        </setting>
                        <setting id="domainrobot_github_branch_setting" string="GitHub update branch">
                            <field name="github_update_branch" placeholder="main"/>
                        </setting>
                        <setting id="domainrobot_github_latest_version_setting" string="Latest GitHub version">
                            <field name="github_latest_version" readonly="1"/>
                        </setting>
                        <setting id="domainrobot_github_update_check_setting" string="Update status">
                            <field name="github_update_available" readonly="1"/>
                        </setting>
                        <div class="mt8">
                            <button name="action_check_github_update" type="object" string="Check GitHub update" class="btn-secondary"/>
                            <button name="action_update_from_github" type="object" string="Update from GitHub" class="btn-primary" attrs="{'invisible': [('github_update_available', '=', False)]}"/>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
