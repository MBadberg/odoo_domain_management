<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_domain_api_test" model="ir.actions.act_window">
        <field name="name">API Test Console</field>
        <field name="res_model">domain.api.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_domain_api_test_form" model="ir.ui.view">
        <field name="name">domain.api.test.form</field>
        <field name="model">domain.api.test</field>
        <field name="arch" type="xml">
            <form string="Domainrobot API Test Console" class="odoo_domain_management_form">
                <header>
                    <button name="action_test_api" type="object" string="Run API Test" class="btn-primary"/>
                    <button name="action_clear" type="object" string="Clear" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Domainrobot API Test Console</h1>
                    </div>
                    <group>
                        <field name="command"/>
                        <field name="domain_name" invisible="command not in ['check_domain', 'status_domain', 'modify_domain', 'delete_domain', 'trade_domain', 'push_domain', 'sync_domain', 'set_domain_renewal_mode', 'renew_domain', 'transfer_domain', 'check_domain_transfer', 'activate_domain_transfer', 'check_domain_application', 'add_domain_application']" placeholder="example.de"/>
                        <field name="domains" invisible="command != 'check_domains'" placeholder="example.de, example.com, example.org" help="One domain per line or comma-separated."/>
                        <field name="contact_handle" invisible="command not in ['trade_domain', 'modify_contact', 'status_contact', 'delete_contact', 'clone_contact', 'add_domain_application']"/>
                        <field name="nameserver_name" invisible="command not in ['check_nameserver', 'add_nameserver', 'modify_nameserver', 'status_nameserver', 'delete_nameserver']"/>
                        <field name="application_id" invisible="command not in ['status_domain_application', 'delete_domain_application', 'pay_domain_application']"/>
                        <field name="class_name" invisible="command not in ['check_domain_application', 'add_domain_application']"/>
                        <field name="period_value" invisible="command not in ['renew_domain', 'add_domain_application']"/>
                        <field name="renewal_mode" invisible="command != 'set_domain_renewal_mode'"/>
                        <field name="transfer_action" invisible="command != 'transfer_domain'"/>
                        <field name="target" invisible="command not in ['push_domain', 'activate_domain_transfer']"/>
                        <field name="ip_address" invisible="command not in ['add_nameserver', 'modify_nameserver']"/>
                        <field name="first_name" invisible="command != 'add_contact'"/>
                        <field name="last_name" invisible="command != 'add_contact'"/>
                        <field name="street" invisible="command != 'add_contact'"/>
                        <field name="zip_code" invisible="command != 'add_contact'"/>
                        <field name="city" invisible="command != 'add_contact'"/>
                        <field name="country" invisible="command != 'add_contact'"/>
                        <field name="email" invisible="command != 'add_contact'"/>
                        <field name="phone" invisible="command != 'add_contact'"/>
                        <field name="extra_fields" widget="text" help="Optional raw request parameters in key=value format."/>
                    </group>
                    <separator string="Response"/>
                    <group>
                        <field name="response_code"/>
                        <field name="response_description"/>
                    </group>
                    <separator string="Parsed Result"/>
                    <field name="result_payload" widget="text"/>
                    <separator string="Raw API Response"/>
                    <field name="raw_response" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_domain_api_test_root" name="API Test Console"
              parent="menu_domain_root"
              action="action_domain_api_test"
              sequence="40"/>

</odoo>
