<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
       <record id="cron_sync_domainrobot_contacts" model="ir.cron">
           <field name="name">Domain Management: Sync Domainrobot Contacts</field>
           <field name="model_id" ref="model_res_partner"/>
           <field name="state">code</field>
           <field name="code">
for partner in model.search([('needs_sync', '=', True)]):
   partner.action_sync_domainrobot_contact()
           </field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="active">False</field>
           <field name="user_id" ref="base.user_root"/>
       </record>

       <record id="cron_sync_domainrobot_domains" model="ir.cron">
           <field name="name">Domain Management: Sync Domainrobot Domains</field>
           <field name="model_id" ref="model_domain_asset"/>
           <field name="state">code</field>
           <field name="code">
for asset in model.search([('needs_sync', '=', True)]):
   asset.action_sync_status()
           </field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="active">False</field>
           <field name="user_id" ref="base.user_root"/>
       </record>

       <record id="cron_sync_domainrobot_transfers" model="ir.cron">
           <field name="name">Domain Management: Sync Domainrobot Transfers</field>
           <field name="model_id" ref="model_domain_transfer"/>
           <field name="state">code</field>
           <field name="code">
for transfer in model.search([('needs_sync', '=', True)]):
   transfer.action_sync_from_api()
           </field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="active">False</field>
           <field name="user_id" ref="base.user_root"/>
       </record>

       <record id="cron_sync_domainrobot_account" model="ir.cron">
           <field name="name">Domain Management: Sync Domainrobot Account</field>
           <field name="model_id" ref="model_domain_account"/>
           <field name="state">code</field>
           <field name="code">
for account in model.search([]):
   account.action_sync_account()
           </field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="active">False</field>
           <field name="user_id" ref="base.user_root"/>
       </record>
   </data>
</odoo>
